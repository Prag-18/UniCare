# Leave MONGO_URI empty to run an in-memory MongoDB (auto-seeded) - handy for the demo.
MONGO_URI=mongodb://127.0.0.1:27017/campuscare
PORT=5000
JWT_SECRET=change-me-in-production
# Optional: enables the real AI assistant. Without it, a rule-based triage is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
